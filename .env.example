# Copy to .env and fill only the providers you use.
# Never commit .env.

ATEROMANTE_ANTHROPIC_API_KEY=
ATEROMANTE_LOCAL_LLM_URL=http://127.0.0.1:11434/api/generate
ATEROMANTE_LOCAL_LLM_MODEL=
ATEROMANTE_LOCAL_LLM_TIMEOUT_MS=15000
ATEROMANTE_CHAT_API_KEY=
ATEROMANTE_CHAT_BASE_URL=
ATEROMANTE_CHAT_MODEL=
ATEROMANTE_CHAT_TIMEOUT_MS=30000
ATEROMANTE_LLM_PROVIDER=mock-local

# Ruta absoluta al ejecutable UCI. Si se omite, se busca "stockfish" en PATH.
ATEROMANTE_UCI_ENGINE_PATH=
ATEROMANTE_UCI_DEPTH=12
ATEROMANTE_UCI_TIMEOUT_MS=15000
